# Copy this file to `.env` (never commit the real one) and adjust the values.
# The backend reads it automatically when started from the repo root or from /backend.

# --- Database (MySQL 8+) ---
DB_URL=jdbc:mysql://localhost:3306/hotel_booking?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# --- Server / CORS ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200
